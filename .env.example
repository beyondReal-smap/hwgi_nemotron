# ============================================================
# PersonaFit 환경변수 템플릿
# ============================================================
# 사용법: cp .env.example .env  → 실제 키 입력
# ============================================================

# --- LLM (Anthropic 외부 + OpenAI 임베딩) ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- LLM (sLLM 내부 — OpenAI 호환 vLLM 엔드포인트, DEFAULT_PROVIDER=sllm) ---
# SLLM_BASE_URL: 미설정 시 default http://3.38.195.121:5015/v1
# SLLM_MODEL: 미설정 시 시작 시 /v1/models를 조회해 첫 모델명을 자동 사용.
#             특정 모델을 강제하려면 명시 (예: gemma4-27b 등).
SLLM_BASE_URL=
SLLM_MODEL=

# --- 포트 설정 ---
WEB_PORT=5101                                  # Next.js (외부 노출)
API_PORT=5102                                  # FastAPI (내부 전용)
API_INTERNAL_URL=http://127.0.0.1:5102         # Next.js rewrites가 프록시할 대상

# Next.js rewrites 사용 시 비워두기. 외부 호스트에서 직접 FastAPI 호출 시에만 설정.
NEXT_PUBLIC_API_BASE_URL=

# --- Kakao Maps JS SDK (시군구 분포 지도) ---
# https://developers.kakao.com/console/app → "JavaScript 키"
# 도메인 등록 필수: localhost (개발), 운영 호스트
# 미설정 시 지도는 안내 메시지로 대체되고 Top10 표만 표시
NEXT_PUBLIC_KAKAO_MAP_APPKEY=

# --- 백엔드 설정 ---
API_CORS_ORIGINS=http://localhost:5101         # Next.js만 허용

# 데이터셋 적재 시 사용
SAMPLE_TARGET_TOTAL=100000

# --- 임베딩 캐시 retention (services/embed_cache.cleanup_old) ---
# startup 시 1회 실행. get() 시 mtime touch되므로 hot 캐시는 보존됨.
# 둘 다 0 이하면 해당 정책 비활성. (예: EMBED_CACHE_RETENTION_DAYS=0 → 나이 정책 끄기)
EMBED_CACHE_RETENTION_DAYS=30                  # N일 이상 미접근 파일 삭제 (기본 30)
EMBED_CACHE_MAX_ENTRIES=50000                  # 캐시 파일 수 상한 (초과 시 oldest 우선 삭제)
